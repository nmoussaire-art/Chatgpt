<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark is the forecast, not the battery.

  v1 drew a battery outline with a small curve inside it; at 48dp on a launcher the outline
  dominated and the curve — the distinctive part — disappeared. Here the median line and its
  uncertainty band *are* the logo, with a single mint dot marking "now". A battery cell is implied
  by the rounded terminal at the top rather than drawn as a container.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Uncertainty band, widening to the right exactly as a forecast interval does. -->
    <path
        android:fillAlpha="0.30"
        android:fillColor="#5DE4B0"
        android:pathData="M26,42 L48,50 L68,63 L84,76 L84,86 L68,74 L48,60 L26,50 Z" />

    <!-- Median projection: the app's signature stroke. -->
    <path
        android:pathData="M26,46 C40,50 56,58 68,68 C75,74 80,79 84,82"
        android:strokeColor="#7BF0C4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7" />

    <!-- "Now" — where the forecast starts. -->
    <path
        android:fillColor="#F6F8FC"
        android:pathData="M26,46 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0" />

    <!-- Reserve threshold, the level the forecast is measured against. -->
    <path
        android:fillAlpha="0.55"
        android:fillColor="#78A9FF"
        android:pathData="M24,88 L86,88 L86,91 L24,91 Z" />
</vector>
